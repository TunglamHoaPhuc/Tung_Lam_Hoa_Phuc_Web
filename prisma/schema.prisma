generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/**
 * |--------------------------------------------------------------------------
 * | AUTHENTICATION
 * |--------------------------------------------------------------------------
 */

model Admin {
  id String @id @default(cuid())

  username String  @unique
  email    String? @unique

  passwordHash String

  fullName  String?
  avatarUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions  AdminSession[]
  auditLogs AuditLog[]

  @@map("admins")
}

model AdminSession {
  id String @id @default(cuid())

  adminId String

  token String @unique

  expiresAt DateTime

  createdAt DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_sessions")
}

/**
 * |--------------------------------------------------------------------------
 * | CMS CONTENT
 * |--------------------------------------------------------------------------
 */

model Page {
  id String @id @default(cuid())

  title String

  slug String @unique

  content String

  published Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("pages")
}

model Category {
  id String @id @default(cuid())

  name String

  slug String @unique

  type CategoryType

  posts Post[]

  createdAt DateTime @default(now())

  @@map("categories")
}

model Post {
  id String @id @default(cuid())

  title String

  slug String @unique

  excerpt String?

  content String

  categoryId String

  thumbnailId String?

  published Boolean @default(false)

  publishedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id])

  thumbnail Media? @relation(fields: [thumbnailId], references: [id])

  @@index([categoryId])
  @@index([published])
  @@map("posts")
}

/**
 * |--------------------------------------------------------------------------
 * | MEDIA
 * |--------------------------------------------------------------------------
 */

model Media {
  id String @id @default(cuid())

  url String

  filename String

  mimeType String

  size Int

  folder String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  posts Post[]

  albumImages AlbumImage[]
  albums      Album[]
  events      Event[]

  @@map("media")
}

model Album {
  id String @id @default(cuid())

  title String

  slug String @unique

  description String?

  coverImageId String?

  eventDate DateTime?

  createdAt DateTime @default(now())

  coverImage Media? @relation(fields: [coverImageId], references: [id])

  images AlbumImage[]

  @@map("albums")
}

model AlbumImage {
  id String @id @default(cuid())

  albumId String

  mediaId String

  sortOrder Int @default(0)

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([albumId])
  @@map("album_images")
}

/**
 * |--------------------------------------------------------------------------
 * | EVENTS
 * |--------------------------------------------------------------------------
 */

model Event {
  id String @id @default(cuid())

  title String

  slug String @unique

  description String?

  type EventType

  startDate DateTime

  endDate DateTime?

  isRecurring Boolean @default(false)

  recurrence Json?

  location String?

  thumbnailId String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  thumbnail Media? @relation(fields: [thumbnailId], references: [id])

  registrations Registration[]

  @@index([startDate])
  @@map("events")
}

model Registration {
  id String @id @default(cuid())

  eventId String

  type RegistrationType

  fullName String

  dharmaName String?

  birthYear Int?

  phone String

  email String?

  address String?

  note String?

  status RegistrationStatus @default(PENDING)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([phone])
  @@map("registrations")
}

/**
 * |--------------------------------------------------------------------------
 * | MEMORIAL
 * |--------------------------------------------------------------------------
 */

model MemorialRecord {
  id String @id @default(cuid())

  fullName String

  dharmaName String?

  avatarUrl String?

  birthDate DateTime?

  deathDate DateTime?

  hometown String?

  address String?

  note String?

  isPublic Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  contacts MemorialContact[]

  assignment MemorialAssignment?

  @@index([fullName])
  @@index([dharmaName])
  @@map("memorial_records")
}

model MemorialContact {
  id String @id @default(cuid())

  memorialId String

  name String

  relationship String?

  phone String?

  address String?

  memorial MemorialRecord @relation(fields: [memorialId], references: [id], onDelete: Cascade)

  @@index([memorialId])
  @@map("memorial_contacts")
}

model MemorialLocation {
  id String @id @default(cuid())

  tower String

  floor Int

  slotNumber String

  status LocationStatus @default(AVAILABLE)

  assignment MemorialAssignment?

  @@unique([tower, floor, slotNumber])
  @@map("memorial_locations")
}

model MemorialAssignment {
  id String @id @default(cuid())

  memorialId String @unique

  locationId String @unique

  assignedDate DateTime @default(now())

  memorial MemorialRecord @relation(fields: [memorialId], references: [id])

  location MemorialLocation @relation(fields: [locationId], references: [id])

  @@map("memorial_assignments")
}

/**
 * |--------------------------------------------------------------------------
 * | SYSTEM
 * |--------------------------------------------------------------------------
 */

model Setting {
  id String @id @default(cuid())

  key String @unique

  value Json?

  updatedAt DateTime @updatedAt

  @@map("settings")
}

model AuditLog {
  id String @id @default(cuid())

  adminId String

  action String

  entity String

  entityId String?

  oldData Json?

  newData Json?

  createdAt DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@map("audit_logs")
}

/**
 * |--------------------------------------------------------------------------
 * | ENUMS
 * |--------------------------------------------------------------------------
 */

enum CategoryType {
  NEWS

  DHARMA

  ANNOUNCEMENT
}

enum EventType {
  KHOA_TU

  LE_HOI

  THOI_KHOA

  CONG_QUA

  TU_THIEN

  KHAC
}

enum RegistrationType {
  KHOA_TU

  CONG_QUA
}

enum RegistrationStatus {
  PENDING

  APPROVED

  REJECTED

  COMPLETED
}

enum LocationStatus {
  AVAILABLE

  USED
}
