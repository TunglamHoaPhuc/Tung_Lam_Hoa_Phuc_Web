generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//
// ====================== AUTH ======================
//

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  role          Role      @default(EDITOR)

  accounts      Account[]
  sessions      Session[]

  media         Media[]
  posts         Post[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])

  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])

  @@map("verification_tokens")
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

//
// ====================== MEDIA ======================
//

model Media {
  id         String   @id @default(cuid())

  url        String
  filename   String
  mimeType   String
  size       Int

  folder     String?

  uploadedBy String

  user User @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  featuredPosts Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([uploadedBy])

  @@map("media")
}

//
// ====================== POSTS ======================
//

model Post {
  id      String @id @default(cuid())

  title   String
  slug    String @unique

  content String

  excerpt String?

  category PostCategory

  published Boolean @default(false)

  featuredImageId String?

  featuredImage Media? @relation(fields: [featuredImageId], references: [id])

  authorId String

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([category])
  @@index([published])

  @@map("posts")
}

enum PostCategory {
  TIN_TUC
  PHAT_PHAP
  THONG_BAO
  GIOI_THIEU
}

//
// ====================== EVENTS ======================
//

model Event {
  id String @id @default(cuid())

  title String

  description String?

  startDate DateTime

  endDate DateTime?

  isRecurring Boolean @default(false)

  recurrence Json?

  location String?

  type EventType

  registrations Registration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startDate])

  @@map("events")
}

enum EventType {
  KHOA_TU
  LE_HOI
  THOI_KHOA
  CONG_QUA
  KHAC
}

//
// ====================== REGISTRATION ======================
//

model Registration {
  id String @id @default(cuid())

  eventId String

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  fullName String

  phone String

  email String?

  status RegistrationStatus @default(PENDING)

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])

  @@map("registrations")
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

//
// ====================== MEMORIAL ======================
//

model Memorial {
  id String @id @default(cuid())

  fullName String

  dharmaName String?

  birthDate DateTime?

  deathDate DateTime?

  position String

  imageUrl String?

  note String?

  isPublic Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fullName])
  @@index([dharmaName])
  @@index([position])

  @@map("memorials")
}

//
// ====================== SETTINGS ======================
//

model Setting {
  id String @id @default(cuid())

  key String @unique

  value Json?

  @@map("settings")
}